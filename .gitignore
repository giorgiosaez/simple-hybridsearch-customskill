# Publish only the managed-route example and its deployment dependencies.
# Everything else stays local unless explicitly added to this allowlist.
/*
!/.gitignore
!/.env.example
!/README.md
!/LICENSE
!/pyproject.toml
!/constraints.txt
!/00_configure_environment.ps1
!/03_deploy_custom_skill.ps1

!/rag_search/
/rag_search/*
!/rag_search/__init__.py
!/rag_search/01_upload_document.py
!/rag_search/02_create_index.py
!/rag_search/04_create_indexer.py
!/rag_search/05_run_indexer.py
!/rag_search/06_search.py
!/rag_search/alternative_ingest_document.py

!/custom_skill/
/custom_skill/*
!/custom_skill/function_app.py
!/custom_skill/host.json
!/custom_skill/requirements.txt

!/docs/
/docs/*
!/docs/operations.md

!/samples/
/samples/*
!/samples/sample.txt

# Never publish local settings, customer data, or generated files.
.env
.env.*
!.env.example
.venv/
.azure/
data/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.coverage
htmlcov/
