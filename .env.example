# Copy to .env or run 00_configure_environment.ps1. Existing host variables win.
# Scripts load .env from the current working directory, not this example.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_INDEX=index1
# Resource root or full /openai/v1 URL from Foundry; both formats are accepted.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Existing chat deployment used to summarize physical pages (not the embedding deployment).
AZURE_OPENAI_SUMMARY_DEPLOYMENT=gpt-5.4-nano
# Optional reduced dimensions; omit to use the deployment's native output.
# AZURE_OPENAI_EMBEDDING_DIMENSIONS=
# default: local DefaultAzureCredential; managed: Azure-hosted managed identity
AZURE_AUTH_MODE=default
# Optional user-assigned managed identity client ID:
# AZURE_CLIENT_ID=

# Script 04: managed Blob data source, skillset, and indexer
AZURE_SEARCH_DATA_SOURCE_NAME=
AZURE_SEARCH_SKILLSET_NAME=
AZURE_SEARCH_INDEXER_NAME=
# Full ARM resource ID of the Storage account (not a key/connection string):
AZURE_STORAGE_RESOURCE_ID=
AZURE_STORAGE_ACCEPTED_CONTAINER=
# No default: trusted tenant ownership must be written by your application.
# Every accepted Blob must also have nonempty file_id metadata.
AZURE_SEARCH_TENANT_METADATA_FIELD=
# Script 03 deploys the Function and writes these into local .env. Keep its key secret.
AZURE_SEARCH_CUSTOM_SKILL_ENDPOINT=
AZURE_SEARCH_CUSTOM_SKILL_KEY=
# Script 04 enables the indexer: initial run, then every 24 hours, in batches of 5.
# Review metadata, Search service identity/RBAC, and schema before running it.
# Language Detection uses the free allowance (20 documents/indexer/day) by default.
# Optional billable multi-service AI resource key for larger runs; same region as Search.
# This is NOT a Search admin key or the embedding deployment's key.
# AZURE_AI_SERVICES_KEY=

# Script 01: upload an approved local file; overwrites Blob content and metadata.
# Upload and Python ingestion share the account, container, and Blob name settings.
AZURE_STORAGE_ACCOUNT_URL=
# Upload only:
RAG_LOCAL_FILE_PATH=
RAG_BLOB_NAME=
# Upload supplies this value; script 06 does not use it as a tenant filter.
# Python ingestion reads its tenant ID from Blob metadata instead.
RAG_TENANT_ID=
# Upload generates file_id and saves it in metadata; do not set RAG_FILE_ID.
# Upload also writes the tenant ID under AZURE_SEARCH_TENANT_METADATA_FIELD.
# Both ingestion routes require these metadata IDs and do not regenerate them.
# RAG_MAX_BLOB_BYTES below limits both local uploads and Python ingestion.

# The Function packages alternative_ingest_document.py for its shared helpers.
# Optional standalone Python ingestion additionally needs AZURE_LANGUAGE_ENDPOINT.
# Python push ingestion uses Azure Language directly; managed ingestion uses Search's skill.
AZURE_LANGUAGE_ENDPOINT=
# Explicitly match this encoding to the configured embedding model.
RAG_TOKENIZER_ENCODING=cl100k_base
RAG_CHUNK_TOKENS=512
RAG_MAX_BLOB_BYTES=26214400
RAG_MAX_PAGES=50

# Script 06: search across all tenants, including records without tenant IDs.
RAG_QUERY=
RAG_SEARCH_MODE=hybrid
RAG_TOP_K=5
RAG_USE_SEMANTIC=false

# Script 05 reuses AZURE_SEARCH_INDEXER_NAME to run an enabled indexer.
